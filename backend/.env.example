DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only (set in the Vercel project settings, not here):
# Custom domain(s), as full origins, comma separated. Vercel's own *.vercel.app
# hosts are picked up automatically from VERCEL_URL and friends.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://koozak.example.com
# (also add the bare domain to DJANGO_ALLOWED_HOSTS)
