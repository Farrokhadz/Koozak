# Leave empty in development: Vite proxies /api to http://localhost:8000.
# In production, set it to the API origin only if it differs from the site's origin.
VITE_API_BASE_URL=

# Public contact details shown on the Help page. Leave a line empty to hide that channel.
# Telegram and Instagram take the username only (with or without @).
VITE_CONTACT_EMAIL=
VITE_CONTACT_TELEGRAM=
VITE_CONTACT_PHONE=
VITE_CONTACT_INSTAGRAM=
